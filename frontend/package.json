    "test": "vitest run",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "jalaali-js": "^2.0.1",
