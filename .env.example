# Copy to .env (never commit .env):  cp .env.example .env
# The values below are for local development only.

# --- PostgreSQL ---
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=notes

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=pgadmin@ai-notes.dev
# Set a unique password before the first Compose startup.
PGADMIN_DEFAULT_PASSWORD=

# --- MinIO (uploaded images and videos) ---
MINIO_ROOT_USER=notes-minio
# At least 8 characters.
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_BUCKET=notes-files

# --- Backend ---
CORS_ORIGINS=http://ai-notes.localhost,http://localhost:5173
LOG_LEVEL=INFO
# Used in links inside emails.
APP_URL=http://ai-notes.localhost
# Encrypts secrets stored in the database (e.g. the Gmail app password).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Comma-separated emails that become admins on sign-up (the first account always does).
ADMIN_EMAILS=

# --- Ollama (the `ollama` container) ---
# Folder with the model files, mounted into the container. The default is the folder of
# the Ollama desktop app (~/.ollama/models), so models you already pulled are reused.
# OLLAMA_MODELS_DIR=
# Must match a name from `docker compose exec ollama ollama list`.
OLLAMA_MODEL=qwen3.5:4b
# How long the model stays in memory after a request.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=300
# Low temperature keeps answers close to the notes.
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192

# --- AI limits ---
# Characters of note text sent to the model per request; raise OLLAMA_NUM_CTX with it.
AI_CONTEXT_CHAR_BUDGET=12000
AI_MAX_QUESTION_CHARS=2000
